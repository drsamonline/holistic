{
  "name": "holistic-desktop",
  "version": "2.7.1",
  "private": true,
  "description": "Desktop shell for Holistic",
  "main": "main.cjs",
  "author": "Dr Sohil Momin",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.holistic.reader",
    "productName": "Holistic",
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/holistic.html",
        "to": "holistic.html"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Holistic"
    },
    "directories": {
      "output": "release"
    }
  }
}